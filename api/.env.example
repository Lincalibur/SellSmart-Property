# Copy to .env for local development. Real values come from
# terraform outputs (cognito_user_pool_id, cognito_web_client_id,
# database_cluster_endpoint) and AWS Secrets Manager once an account exists
# -- never commit real values.

PORT=3000
NODE_ENV=development

COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

DATABASE_URL=postgres://user:password@localhost:5432/sellsmart
DATABASE_SSL=false

# terraform_output: storage.documents_bucket. Leave S3_ENDPOINT unset in
# production (real AWS) -- it's only for pointing at LocalStack locally/CI.
AWS_REGION=af-south-1
DOCUMENTS_BUCKET=
S3_ENDPOINT=
